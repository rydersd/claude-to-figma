{
  "name": "llm2figma",
  "description": "Model-agnostic Figma MCP bridge with bounded inspection, reusable references, and batch design operations",
  "version": "0.1.0",
  "module": "dist/server.js",
  "main": "dist/server.js",
  "bin": {
    "llm2figma": "dist/server.js",
    "claude-to-figma": "dist/server.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "scripts": {
    "start": "bun run dist/server.js",
    "socket": "bun run src/socket.ts",
    "setup": "./scripts/setup.sh",
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "build:plugin": "tsup --config tsup.config.ts -- src/claude_figma_plugin/src/main.ts",
    "build:watch": "tsup --watch",
    "dev": "bun run build:watch",
    "pub:release": "bun run build && npm publish"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.123.0",
    "@types/bun": "latest",
    "bun-types": "^1.2.5",
    "tsup": "^8.4.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.13.1",
    "uuid": "latest",
    "ws": "latest",
    "zod": "3.22.4"
  }
}
