{
  "name": "llm2figma",
  "displayName": "llm2figma",
  "version": "0.2.0",
  "description": "Lets Claude read and draw in the open Figma file through a local plugin: auto layout, variables, components, text, vectors and batch edits.",
  "author": { "name": "Ryder Booth", "url": "https://github.com/rydersd" },
  "repository": "https://github.com/rydersd/claude-to-figma",
  "license": "MIT",
  "keywords": ["figma", "design", "design-system", "mcp"],
  "mcpServers": {
    "LLM2Figma": {
      "command": "bash",
      "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/run-server.sh"],
      "env": {
        "L2F_ALL": "${L2F_ALL:-}",
        "L2F_FILE_KEY": "${L2F_FILE_KEY:-}",
        "L2F_COMMENTS": "${L2F_COMMENTS:-}",
        "L2F_COMMENTS_WRITE": "${L2F_COMMENTS_WRITE:-}",
        "L2F_FLOWS": "${L2F_FLOWS:-}",
        "L2F_VARIABLES_WRITE": "${L2F_VARIABLES_WRITE:-}",
        "L2F_COMPONENT_PROPERTIES": "${L2F_COMPONENT_PROPERTIES:-}",
        "L2F_GRID_LAYOUT": "${L2F_GRID_LAYOUT:-}",
        "L2F_VERIFY": "${L2F_VERIFY:-}",
        "L2F_SPEC_SYNC": "${L2F_SPEC_SYNC:-}",
        "L2F_CODE_MAP": "${L2F_CODE_MAP:-}",
        "L2F_DEV_MODE": "${L2F_DEV_MODE:-}",
        "L2F_SLIDES": "${L2F_SLIDES:-}",
        "L2F_TEXT_PATH": "${L2F_TEXT_PATH:-}",
        "L2F_SPEC_DIR": "${L2F_SPEC_DIR:-}"
      }
    }
  }
}
